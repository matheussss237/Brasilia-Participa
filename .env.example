# Copie este arquivo para ".env" e preencha com os dados do seu cluster no MongoDB Atlas.
# Atlas > Database > Connect > Drivers > copie a "connection string".
# Troque <password> pela senha do usuário do banco (sem os sinais < >).
# Se a senha tiver caracteres especiais (@ # / : ?), codifique-os: @ vira %40, # vira %23, / vira %2F.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nome do banco (é criado automaticamente na primeira execução)
MONGODB_DB=brasilia_participa

# Porta do servidor local
PORT=3000
